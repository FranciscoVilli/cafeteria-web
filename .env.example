# Copie este archivo como .env.local y complete los valores de su proyecto de Supabase
# (Project Settings → API). En Vercel, configúrelos en Settings → Environment Variables.

# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret). SOLO en el servidor: nunca la publique ni la
# ponga en variables que empiecen con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
